{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "rootDir": ".",
        "noEmit": true,
        "types": [
            "node",
            "bun-types"
        ],
        "jsx": "react-jsx",
        "paths": {
            "@/*": [
                "./src/*"
            ]
        },
        "lib": [
            "ES2022",
            "DOM"
        ]
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "app/**/*.tsx"
    ],
    "exclude": [
        "node_modules"
    ]
}
