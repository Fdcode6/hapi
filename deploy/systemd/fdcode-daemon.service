[Unit]
Description=FDCode Local Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/%u/hapi
EnvironmentFile=/home/%u/.config/fdcode/daemon.env
ExecStart=/usr/bin/env bun run --cwd apps/fdcode-daemon start
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
