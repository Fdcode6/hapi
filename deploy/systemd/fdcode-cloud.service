[Unit]
Description=FDCode Cloud API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/fdcode/hapi
EnvironmentFile=/etc/fdcode/cloud.env
ExecStart=/usr/bin/env bun run --cwd apps/cloud-api start
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
